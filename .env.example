# Copy to .env and fill in. Server-side only — never expose these to the browser.

# OpenAI credentials for the agent. When unset, the agent falls back to the
# clearly labelled offline rule-based demo model (no LLM involved).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# SQLite database location (defaults to <repo>/data/gatekeeper.db).
# GATEKEEPER_DB_PATH=

# Principal the stdio MCP server is bound to. Required for `pnpm mcp:stdio`.
# One of: u_alice, u_bob, u_carl, u_maya, u_sam, u_ada
GATEKEEPER_DEMO_PRINCIPAL=u_alice
